{
  "name": "sudoku-snap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:wasm": "node scripts/build-wasm.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:wasm": "tsx --test tests/wasm/*.test.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --project storybook",
    "test:visual": "npm run build-storybook && playwright test --config tests/storybook/playwright.config.ts",
    "test:visual:update": "npm run build-storybook && playwright test --config tests/storybook/playwright.config.ts --update-snapshots",
    "test:visual:environment": "node scripts/storybook-environment.mjs --check && node --test tests/storybook/environment.test.mjs",
    "benchmark:core": "tsx benchmarks/core.ts",
    "benchmark:browser": "tsx benchmarks/browser.ts",
    "benchmark:compare": "tsx benchmarks/compare.ts",
    "postinstall": "node scripts/copy-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
